# Base path of the API. Leave as /api/v1 in development so Vite proxies to the
# Go server (see vite.config.ts). Set an absolute URL for a deployed build.
VITE_API_BASE_URL=/api/v1

# Display currency and locale. The server always sends integer minor units.
VITE_CURRENCY=USD
VITE_LOCALE=en-US

# Development proxy target for `npm run dev`.
VITE_PROXY_TARGET=http://localhost:8080
