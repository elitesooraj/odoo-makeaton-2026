# Copy to .env before running docker compose or the API locally.
# Values here are development defaults and are not secrets.

APP_ENV=development
HTTP_PORT=8080

# Local (go run) connection. Compose overrides the host to "postgres".
DATABASE_URL=postgres://brightloop:brightloop@localhost:5432/brightloop?sslmode=disable
POSTGRES_USER=brightloop
POSTGRES_PASSWORD=brightloop
POSTGRES_DB=brightloop

CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173

SESSION_COOKIE_NAME=bl_session
SESSION_TTL=168h
COOKIE_SECURE=false

# Leave SMTP_HOST empty to print reset links to the API log instead of sending.
# Compose sets SMTP_HOST=mailpit; the inbox is at http://localhost:8025.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Brightloop <no-reply@brightloop.test>

# Used by `make seed`. The password must satisfy the policy:
# longer than 8 characters, upper, lower and a special character.
ADMIN_EMAIL=admin@brightloop.test
ADMIN_PASSWORD=ChangeMe!Now1

# Optional. Seeded as STAFF with invoices.write and payments.write granted,
# so the invoice/payment demo does not depend on an admin.
FINANCE_EMAIL=finance@brightloop.test
FINANCE_PASSWORD=Finance!Now1

CURRENCY=USD
COMPANY_TIMEZONE=UTC
LOG_LEVEL=info
