# Copy to .env before running `make up`. Values here are safe development
# defaults. For a server, see docs/DEPLOYMENT.md and change every secret.

COMPOSE_PROJECT_NAME=brightloop

APP_ENV=development

# Host ports. The frontend/API are reachable on these; Postgres and Mailpit are
# bound to 127.0.0.1 only.
API_PORT=8080
FRONTEND_PORT=5173
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Database. Compose builds the container DSN from these; DATABASE_URL is only
# used by host tooling.
POSTGRES_USER=brightloop
POSTGRES_PASSWORD=brightloop
POSTGRES_DB=brightloop
DATABASE_URL=postgres://brightloop:brightloop@localhost:5432/brightloop?sslmode=disable

CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173

SESSION_COOKIE_NAME=bl_session
SESSION_TTL=168h
COOKIE_SECURE=false

# In development Compose starts Mailpit and the API delivers there. The inbox is
# at http://localhost:8025. Leave these blank for local work; set real SMTP
# values for production.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Brightloop <no-reply@brightloop.test>

# Created automatically by the seed job on the first `docker compose up` (and
# re-checked, never overwritten, on every later boot). The password must be
# longer than 8 characters with upper, lower and a special character. Leave
# ADMIN_PASSWORD blank to get a generated one printed in the seed logs.
ADMIN_EMAIL=admin@brightloop.test
ADMIN_PASSWORD=ChangeMe!Now1

# Optional. Seeded as STAFF with invoices.write and payments.write granted, so
# the invoice/payment demo does not depend on an admin. Leave FINANCE_EMAIL
# blank to skip.
FINANCE_EMAIL=finance@brightloop.test
FINANCE_PASSWORD=Finance!Now1

CURRENCY=USD
COMPANY_TIMEZONE=UTC
LOG_LEVEL=info

# Image tags. Leave the defaults for local builds; CI can override them.
API_IMAGE=brightloop-api:local
TEST_IMAGE=brightloop-test:local
FRONTEND_IMAGE=brightloop-frontend:local
VERSION=dev
COMMIT=unknown
